# --- CRM OAuth app (workspace-level distribution) ---
# CRM_* names are preferred; the legacy GHL_* names still work.
# Create the app at https://marketplace.gohighlevel.com -> My Apps.
CRM_CLIENT_ID=
CRM_CLIENT_SECRET=
# Must exactly match a Redirect URL configured on the app.
CRM_REDIRECT_URI=http://localhost:3000/api/auth/callback
# Your app's ID (the part of the client id before the dash). Limits sync to sub-accounts with the app installed
# and ignores webhooks for other apps.
CRM_APP_ID=

# --- Security ---
# Random 32+ char string that signs the session cookie. Generate: openssl rand -hex 32
SESSION_SECRET=
# 32-byte key (64 hex chars) that encrypts OAuth tokens at rest. Generate: openssl rand -hex 32
# If unset, a key is derived from SESSION_SECRET.
TOKEN_ENCRYPTION_KEY=

# --- Webhooks (install / uninstall / new sub-account) ---
# Public keys from your CRM's webhook docs, as PEM (\n escapes are fine).
# x-ghl-signature (Ed25519):
CRM_WEBHOOK_ED25519_PUBLIC_KEY=
# x-wh-signature (RSA, legacy):
CRM_WEBHOOK_PUBLIC_KEY=

# --- Sync ---
# In-process auto-sync interval in hours (0 disables it; use /api/cron/sync instead).
AUTO_SYNC_HOURS=6
# Bearer secret for GET/POST /api/cron/sync (external schedulers).
CRON_SECRET=
# Custom value key on each sub-account holding ad spend.
CRM_AD_SPEND_CUSTOM_VALUE=ad_spend_daily
# Timezone used for the agency-wide date axis.
AGENCY_TIMEZONE=UTC

# --- Optional ---
# Public URL of this app (adds an "Open God View" link to alerts).
APP_URL=http://localhost:3000
# Where agency data files are stored.
# DATA_DIR=./data

# --- Public site / legal pages (set before launch) ---
NEXT_PUBLIC_APP_NAME=God View
LEGAL_ENTITY_NAME=
SUPPORT_EMAIL=
LEGAL_JURISDICTION=the State of Delaware, United States
